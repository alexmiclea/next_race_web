# Copy to .env and fill in. Without these, the scraper only writes files to output/.
SUPABASE_URL=https://<project-id>.supabase.co
# Supabase → Project Settings → API Keys → Secret keys. Server-only; never commit it.
SUPABASE_SECRET_KEY=sb_secret_...

# For npm run describe: Claude API key from console.anthropic.com -> API Keys. Never commit it.
ANTHROPIC_API_KEY=sk-ant-...
