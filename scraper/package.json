{
  "name": "next-race-scraper",
  "private": true,
  "type": "module",
  "description": "Collects race listings from approved sources into a review queue.",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "scrape": "node --env-file-if-exists=.env src/run.ts",
    "geocode": "node --env-file=.env src/geocode.ts",
    "describe": "node --env-file=.env src/describe.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@supabase/supabase-js": "^2.117.2",
    "cheerio": "^1.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
